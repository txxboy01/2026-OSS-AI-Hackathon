# RPM 백엔드 설정 템플릿: 복사해서 rpm-backend/.env 로 만든 뒤 값을 채웁니다.
# 알 수 없는 키가 있으면 서버가 기동하지 않으므로 app/config.py 에 있는 설정만 넣으세요.

APP_ENV=development

# Gemini API 키와 모델 ID (gemini- 로 시작하는 실제 모델 ID). 비어 있으면 기동하지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=

# 프론트엔드 origin 목록 (JSON 배열). 배포 시 실제 프론트 HTTPS origin 을 추가하세요.
# 예: ["https://a1.scnuoss.net"]
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
