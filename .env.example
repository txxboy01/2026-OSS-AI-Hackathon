# ==========================================
# RPM Project Environment Variables Template
# ==========================================
# 이 파일은 저장소 루트 .env 용입니다 (프론트 빌드·배포).
# 백엔드 설정(Gemini 키·CORS)은 rpm-backend/.env.example 을 복사해 rpm-backend/.env 로 만드세요.

# 1. Frontend (Next.js) Settings
# 백엔드 API 서버 주소. deploy/deploy.sh 가 이 값을 읽어 정적 빌드에 넣습니다.
# 배포 시에는 반드시 실제 백엔드 HTTPS 주소로 바꾸세요 (기본값은 로컬 개발용).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 2. Deploy (deploy/deploy.sh) Settings
USER_ID=
PASSWORD=
HOST=
WORK_PATH=
# DEPLOY_ADDRESS=https://a1.scnuoss.net/
