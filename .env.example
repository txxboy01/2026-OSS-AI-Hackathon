# ==========================================
# RPM Project Environment Variables Template
# ==========================================

# 1. Backend (FastAPI & AI Pipeline) Settings
PORT=8000
ENVIRONMENT=development

# OpenAI API Key (팀원 각자의 API 키 또는 팀 공용 키 입력)
OPENAI_API_KEY=your_openai_api_key_here

# CORS 허용 도메인 (쉼표로 구분, 배포 시 추가 도메인 반영)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 2. Frontend (Next.js) Settings
# 백엔드 API 서버 주소
NEXT_PUBLIC_API_URL=http://localhost:8000